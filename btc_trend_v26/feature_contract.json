{
  "schema_version": "1.0",
  "contract_id": "BTC_TREND_V26_FEATURE_CONTRACT_R1",
  "master_id": "btc_trend",
  "production_version": "V2.6",
  "research_version": "V3.0",
  "status": "R1_FEATURE_SCHEMA_LOCKED_RESEARCH_ONLY",
  "purpose": "Define deterministic, auditable raw-data-to-feature interfaces for MASTER BTC TREND V2.6 without inventing production scores or silently promoting research thresholds.",
  "promotion_policy": {
    "production_use_allowed": false,
    "silent_promotion_forbidden": true,
    "requires_oos_validation": true,
    "requires_score_contract_lock": true,
    "requires_shadow_mode": true,
    "requires_explicit_acceptance": true
  },
  "global_rules": {
    "completed_candle_only_for_structure_and_confirmation": true,
    "current_incomplete_candle_role": "OBSERVE_ONLY",
    "missing_is_zero": false,
    "missing_weighted_feature_policy": "EXCLUDE_AND_RENORMALIZE_VALID_WEIGHT",
    "cross_venue_repair_forbidden": true,
    "chat_memory_backfill_forbidden": true,
    "last_good_substitution_forbidden_for_current_score": true,
    "stale_source_forbidden_for_current_score": true,
    "double_count_same_raw_fact_within_one_composite": false,
    "source_timestamp_required": true,
    "feature_timestamp_required": true,
    "lineage_required": true
  },
  "standard_states": {
    "directional_5": [
      "STRONG_SHORT",
      "SHORT",
      "NEUTRAL",
      "LONG",
      "STRONG_LONG"
    ],
    "evidence_5": [
      "NONE",
      "WEAK",
      "MODERATE",
      "STRONG",
      "VERY_STRONG"
    ],
    "availability": [
      "CURRENT",
      "N_A_SOURCE_MISSING",
      "N_A_STALE",
      "N_A_VALIDATION_FAIL",
      "N_A_THRESHOLD_UNAPPROVED",
      "N_A_INSUFFICIENT_HISTORY"
    ]
  },
  "source_registry": {
    "market_global": {
      "path": "market_vault/output/latest_summary.json",
      "role": "market and macro facts only"
    },
    "market_macro_liquidity": {
      "path": "market_vault/output/latest_macro_liquidity.json",
      "role": "macro and liquidity facts only"
    },
    "btc_etf_flows": {
      "path": "market_vault/output/latest_etf_flows.json",
      "role": "BTC ETF flow facts only"
    },
    "derivatives": {
      "path": "derivatives/output/latest_summary.json",
      "role": "Bitget BTC derivatives primary facts"
    },
    "microstructure": {
      "path": "derivatives/output/latest_microstructure.json",
      "role": "BTC CVD, taker and depth facts"
    },
    "derivatives_health": {
      "path": "derivatives/state/collector_state.json",
      "role": "freshness and exact-window eligibility"
    },
    "shared_fact_vault": {
      "path": "money_master_os/shared_fact_vault/output/latest.json",
      "role": "availability and public-fact lineage only; never another MASTER decision"
    }
  },
  "feature_groups": {
    "TREND_DIRECTION": {
      "score_owner": "TREND_LONG_SHORT",
      "feature_ids": [
        "STRUCTURE_1D",
        "STRUCTURE_4H",
        "STRUCTURE_1W",
        "VOLUME_WAVE",
        "EMA_MA_STACK",
        "SPOT_ETF_FLOW",
        "DERIVATIVES_STATE",
        "VALUE_OVEREXTENSION",
        "LIQUIDITY_MACRO"
      ]
    },
    "BOTTOM": {
      "score_owner": "BOTTOM",
      "feature_ids": [
        "BOTTOM_STRUCTURE_1D",
        "BOTTOM_STRUCTURE_4H",
        "BOTTOM_LOCATION_1W",
        "CAPITULATION",
        "BOTTOM_MOMENTUM",
        "BOTTOM_SPOT_ETF",
        "BOTTOM_DERIVATIVES_FLOW",
        "BOTTOM_VALUE",
        "BOTTOM_MACRO"
      ]
    },
    "TOP": {
      "score_owner": "TOP",
      "feature_ids": [
        "TOP_STRUCTURE_1D",
        "TOP_STRUCTURE_4H",
        "TOP_LOCATION_1W",
        "BLOWOFF_DISTRIBUTION",
        "TOP_MOMENTUM",
        "TOP_SPOT_ETF",
        "TOP_DERIVATIVES_FLOW",
        "TOP_VALUE",
        "TOP_MACRO"
      ]
    },
    "ACCUMULATION": {
      "score_owner": "ACCUMULATION",
      "feature_ids": [
        "ACCUM_BASE_1D",
        "ACCUM_IMPROVEMENT_4H",
        "ACCUM_LOCATION_1W",
        "ACCUM_VOLUME_LEAD",
        "ACCUM_SPOT_ETF_FLOW",
        "ACCUM_CVD_TAKER_DERIVATIVES",
        "ACCUM_NONCHASE_VALUE",
        "ACCUM_EMA_WAVE",
        "ACCUM_MACRO"
      ]
    }
  },
  "features": {
    "STRUCTURE_1D": {
      "timeframe": "1D",
      "state_type": "directional_5",
      "inputs": ["completed_1d_ohlc"],
      "required_facts": ["confirmed_swing_highs", "confirmed_swing_lows", "bos_up", "bos_down", "reclaim", "breakdown"],
      "classifier_policy": "STRUCTURE_CLASSIFIER_REQUIRED",
      "threshold_status": "UNAPPROVED_UNTIL_DETERMINISTIC_PIVOT_RULE_LOCKED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "STRUCTURE_4H": {
      "timeframe": "4H",
      "state_type": "directional_5",
      "inputs": ["completed_4h_ohlc"],
      "required_facts": ["confirmed_swing_highs", "confirmed_swing_lows", "bos_up", "bos_down", "reclaim", "breakdown"],
      "classifier_policy": "STRUCTURE_CLASSIFIER_REQUIRED",
      "threshold_status": "UNAPPROVED_UNTIL_DETERMINISTIC_PIVOT_RULE_LOCKED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "STRUCTURE_1W": {
      "timeframe": "1W",
      "state_type": "directional_5",
      "inputs": ["completed_1w_ohlc"],
      "required_facts": ["confirmed_swing_highs", "confirmed_swing_lows", "bos_up", "bos_down"],
      "classifier_policy": "STRUCTURE_CLASSIFIER_REQUIRED",
      "threshold_status": "UNAPPROVED_UNTIL_DETERMINISTIC_PIVOT_RULE_LOCKED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "VOLUME_WAVE": {
      "timeframe": "1D+4H",
      "state_type": "directional_5",
      "inputs": ["completed_volume", "price_impulse_direction", "volume_ma5", "volume_ma10", "wave_energy"],
      "double_count_guard": "raw volume facts owned here and must not be rescored in structure features",
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "EMA_MA_STACK": {
      "timeframe": "1D+4H",
      "state_type": "directional_5",
      "inputs": ["close", "ema20", "ma50", "ma200"],
      "classifier_rules": {
        "STRONG_LONG": "close>ema20>ma50>ma200 on both 1D and 4H",
        "LONG": "majority bullish ordering with no 1D bearish full-stack",
        "NEUTRAL": "mixed or crossing stack",
        "SHORT": "majority bearish ordering with no 1D bullish full-stack",
        "STRONG_SHORT": "close<ema20<ma50<ma200 on both 1D and 4H"
      },
      "threshold_status": "DETERMINISTIC_NO_NUMERIC_THRESHOLD",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "SPOT_ETF_FLOW": {
      "timeframe": "current+daily",
      "state_type": "directional_5",
      "inputs": ["btc_etf_net_flow", "spot_flow_if_available"],
      "source_paths": ["market_vault/output/latest_etf_flows.json"],
      "threshold_status": "RESEARCH_REQUIRED_FOR_STRONG_VS_NORMAL_BANDS",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "DERIVATIVES_STATE": {
      "timeframe": "1H+4H+24H",
      "state_type": "directional_5",
      "inputs": ["price_change", "oi_change", "funding", "cvd", "taker_buy_sell"],
      "source_paths": ["derivatives/output/latest_summary.json", "derivatives/output/latest_microstructure.json", "derivatives/state/collector_state.json"],
      "hard_rules": {
        "exact_window_required": true,
        "24h_missing_does_not_zero_1h_or_4h": true,
        "cross_venue_repair_forbidden": true
      },
      "categorical_states_supported": [
        "PRICE_UP_OI_UP_LONG_BUILD",
        "PRICE_DOWN_OI_UP_BEARISH_BUILD",
        "PRICE_UP_OI_DOWN_SQUEEZE_RISK",
        "PRICE_DOWN_OI_DOWN_DELEVERAGING",
        "MIXED"
      ],
      "threshold_status": "CATEGORY_MAPPING_DETERMINISTIC; STRONG_VS_NORMAL_REQUIRES_VALIDATION",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "VALUE_OVEREXTENSION": {
      "timeframe": "1D+1W",
      "state_type": "directional_5",
      "inputs": ["distance_from_ema20_atr", "rsi", "value_context_if_available"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "LIQUIDITY_MACRO": {
      "timeframe": "current+daily+7D",
      "state_type": "directional_5",
      "inputs": ["rates", "real_yield", "stablecoin_supply", "tga", "liquidity_facts"],
      "source_paths": ["market_vault/output/latest_macro_liquidity.json", "market_vault/output/latest_summary.json"],
      "threshold_status": "RESEARCH_REQUIRED_FOR_COMPOSITE_STATE",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "BOTTOM_STRUCTURE_1D": {
      "timeframe": "1D",
      "state_type": "evidence_5",
      "inputs": ["completed_1d_turn", "failed_breakdown", "reclaim", "higher_low"],
      "threshold_status": "RESEARCH_REQUIRED",
      "cap_dependency": "if no confirmed 1D turn then final BOTTOM score max 59",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "BOTTOM_STRUCTURE_4H": {
      "timeframe": "4H",
      "state_type": "evidence_5",
      "inputs": ["completed_4h_turn", "reclaim", "higher_low"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "BOTTOM_LOCATION_1W": {
      "timeframe": "1W",
      "state_type": "evidence_5",
      "inputs": ["weekly_location", "distance_from_long_term_support"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "CAPITULATION": {
      "timeframe": "1H+1D",
      "state_type": "evidence_5",
      "inputs": ["min_rsi24", "min_ret12_24", "max_volz24", "min_taker6_24", "max_lower_wick24", "daily_ext_atr"],
      "research_source": "btc_backtest/v26_threshold_research.py",
      "candidate_seed_status": "OOS_CANDIDATES_EXIST_BUT_NOT_PRODUCTION_APPROVED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "BOTTOM_MOMENTUM": {
      "timeframe": "1D+4H",
      "state_type": "evidence_5",
      "inputs": ["rsi", "ema_slope", "wave_turn"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "BOTTOM_SPOT_ETF": {
      "timeframe": "daily",
      "state_type": "evidence_5",
      "inputs": ["btc_etf_net_flow", "spot_flow_if_available"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "BOTTOM_DERIVATIVES_FLOW": {
      "timeframe": "1H+4H+24H",
      "state_type": "evidence_5",
      "inputs": ["oi_washout", "cvd", "taker", "funding"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "BOTTOM_VALUE": {
      "timeframe": "1D+1W",
      "state_type": "evidence_5",
      "inputs": ["distance_from_ema20_atr", "value_context_if_available"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "BOTTOM_MACRO": {
      "timeframe": "daily+7D",
      "state_type": "evidence_5",
      "inputs": ["macro_liquidity_state"],
      "threshold_status": "RESEARCH_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "TOP_STRUCTURE_1D": {
      "timeframe": "1D",
      "state_type": "evidence_5",
      "inputs": ["failed_breakout", "lower_high", "breakdown", "rejection"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "cap_dependency": "if 1D HH-HL remains intact then final TOP score max 59",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "TOP_STRUCTURE_4H": {
      "timeframe": "4H",
      "state_type": "evidence_5",
      "inputs": ["failed_breakout", "lower_high", "breakdown"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "TOP_LOCATION_1W": {
      "timeframe": "1W",
      "state_type": "evidence_5",
      "inputs": ["weekly_location", "distance_from_long_term_resistance"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "BLOWOFF_DISTRIBUTION": {
      "timeframe": "1H+1D",
      "state_type": "evidence_5",
      "inputs": ["failed_high", "upper_wick", "volume_spike", "follow_through_failure", "cvd_divergence", "oi_funding_overheat"],
      "research_policy": "DO_NOT_MIRROR_BOTTOM_THRESHOLDS",
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "TOP_MOMENTUM": {
      "timeframe": "1D+4H",
      "state_type": "evidence_5",
      "inputs": ["rsi", "ema_slope", "wave_exhaustion"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "TOP_SPOT_ETF": {
      "timeframe": "daily",
      "state_type": "evidence_5",
      "inputs": ["btc_etf_flow_slowdown", "spot_distribution_if_available"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "TOP_DERIVATIVES_FLOW": {
      "timeframe": "1H+4H+24H",
      "state_type": "evidence_5",
      "inputs": ["oi_build", "funding_overheat", "cvd_divergence", "taker_distribution"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "TOP_VALUE": {
      "timeframe": "1D+1W",
      "state_type": "evidence_5",
      "inputs": ["distance_from_ema20_atr", "value_context_if_available"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "TOP_MACRO": {
      "timeframe": "daily+7D",
      "state_type": "evidence_5",
      "inputs": ["macro_liquidity_state"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "ACCUM_BASE_1D": {
      "timeframe": "1D",
      "state_type": "evidence_5",
      "inputs": ["prior_decline_or_correction", "base", "higher_low_or_failed_low", "compression"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "ACCUM_IMPROVEMENT_4H": {
      "timeframe": "4H",
      "state_type": "evidence_5",
      "inputs": ["lower_low_failure", "higher_low", "reclaim", "momentum_improvement"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "ACCUM_LOCATION_1W": {
      "timeframe": "1W",
      "state_type": "evidence_5",
      "inputs": ["weekly_location", "distance_from_long_term_support"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "ACCUM_VOLUME_LEAD": {
      "timeframe": "1D+4H",
      "state_type": "evidence_5",
      "inputs": ["selling_volume_decay", "buy_volume_lead", "volume_5v20"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "ACCUM_SPOT_ETF_FLOW": {
      "timeframe": "daily",
      "state_type": "evidence_5",
      "inputs": ["btc_etf_net_flow", "spot_flow_if_available"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "ACCUM_CVD_TAKER_DERIVATIVES": {
      "timeframe": "1H+4H",
      "state_type": "evidence_5",
      "inputs": ["cvd_improvement", "taker_improvement", "oi_behavior"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    },
    "ACCUM_NONCHASE_VALUE": {
      "timeframe": "1D",
      "state_type": "evidence_5",
      "inputs": ["not_rapid_rise", "distance_from_ema20_atr", "value_context_if_available"],
      "cap_dependency": "rapid-rise state caps final ACCUMULATION score at 64",
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "ACCUM_EMA_WAVE": {
      "timeframe": "1D+4H",
      "state_type": "evidence_5",
      "inputs": ["ema_slope_improvement", "wave_energy_improvement"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_THRESHOLD_UNAPPROVED"
    },
    "ACCUM_MACRO": {
      "timeframe": "daily+7D",
      "state_type": "evidence_5",
      "inputs": ["macro_liquidity_state"],
      "threshold_status": "RESEARCH_V2_REQUIRED",
      "fallback": "N_A_SOURCE_MISSING"
    }
  },
  "output_contract": {
    "path": "btc_trend_v26/output/latest_features.json",
    "required_top_level_fields": [
      "schema_version",
      "generated_at_utc",
      "asof_utc",
      "status",
      "coverage",
      "features",
      "source_timestamps",
      "validation",
      "lineage"
    ],
    "required_per_feature_fields": [
      "feature_id",
      "availability",
      "state",
      "asof_utc",
      "source_ids",
      "source_timestamps",
      "reason_codes"
    ],
    "score_fields_forbidden_in_feature_output": true
  },
  "validation_guards": {
    "duplicate_raw_fact_same_composite": "FAIL",
    "future_candle_use": "FAIL",
    "incomplete_candle_as_confirmation": "FAIL",
    "stale_source_as_current": "FAIL",
    "cross_venue_fill": "FAIL",
    "research_threshold_silent_promotion": "FAIL",
    "missing_as_zero": "FAIL",
    "other_master_decision_input": "FAIL"
  },
  "r1_lock": {
    "locked_now": [
      "feature ids",
      "feature ownership by score family",
      "standard state vocabularies",
      "source-role boundaries",
      "missing/stale handling",
      "completed-candle rule",
      "double-count guard",
      "output schema",
      "promotion safeguards"
    ],
    "not_locked_yet": [
      "numeric thresholds",
      "pivot/swing detection parameters",
      "strong-vs-normal directional bands",
      "TOP Research V2 thresholds",
      "ACCUMULATION Research V2 thresholds",
      "score conversion weights beyond existing V2.6 canonical weights"
    ]
  }
}
